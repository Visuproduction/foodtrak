# ─── Supabase ───────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/<project-id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — SERVER ONLY (cron purge, admin ops). Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Schéma PostgreSQL isolé (tables dans le schema `foodtrak`, pas `public`)
# Configuré automatiquement dans src/lib/supabase/*.ts

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slug du commerçant par défaut pour le dev local (ex: pizza-truck-paris)
NEXT_PUBLIC_DEFAULT_MERCHANT_SLUG=demo-truck

# ─── Vercel Cron ────────────────────────────────────────────
# Générer une clé aléatoire : openssl rand -hex 32
CRON_SECRET=your-cron-secret-for-purge-job
